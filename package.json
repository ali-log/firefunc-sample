{
  "name": "firefunc-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A complex task/project-tracker SaaS sample app for validating the FireFunc auto-fix loop end-to-end.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/api/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "test:e2e": "playwright test",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "zod": "^3.23.8",
    "better-sqlite3": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "@vitejs/plugin-react": "^4.3.2"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1",
    "@types/node": "^20.16.10",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@playwright/test": "^1.55.0"
  }
}
